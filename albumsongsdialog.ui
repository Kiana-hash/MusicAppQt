<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AlbumSongsDialog</class>
 <widget class="QDialog" name="AlbumSongsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
