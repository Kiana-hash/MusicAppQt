<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ArtistDashboard</class>
 <widget class="QDialog" name="ArtistDashboard">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>720</width>
    <height>730</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Dialog</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QDialog#ArtistDashboard {
    color: #F7F5FF;

    background: qradialgradient(
        cx: 0.78,
        cy: 0.05,
        radius: 1.15,
        stop: 0 #441A64,
        stop: 0.22 #251945,
        stop: 0.48 #14142F,
        stop: 1 #070815
    );

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}


QLabel {
    color: #F7F5FF;
    background: transparent;
}

QFrame#sidebarFrame {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #15102E,
        stop: 0.42 #0E0E24,
        stop: 1 #080815
    );

    border: none;
    border-right: 1px solid #49326B;
}


/* Artist Studio title */

QLabel#appTitleLabel {
    color: #FFFFFF;

    font-family: &quot;Bahnschrift&quot;;
    font-size: 16pt;
    font-weight: 700;
}


/* YOUR MUSIC */

QLabel#musicSectionLabel {
    color: #9E91B7;

    font-family: &quot;Bahnschrift&quot;;
    font-size: 9pt;
    font-weight: 600;

    letter-spacing: 1px;
}




QPushButton#createAlbumButton,
QPushButton#createSingleButton,
QPushButton#accountButton,
QPushButton#logoutButton {
    min-height: 32px;

    padding: 2px 12px;

    border-radius: 9px;

    font-family: &quot;Segoe UI&quot;;
    font-weight: 600;
}


QPushButton#createAlbumButton {
    color: #FFFFFF;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 #7045CE,
        stop: 0.52 #9B5CF6,
        stop: 1 #E64BAD
    );

    border: 1px solid #BF91FF;
}


QPushButton#createAlbumButton:hover {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 #8358E5,
        stop: 0.52 #B07BFF,
        stop: 1 #FF5FC1
    );

    border-color: #27D7F2;
}


QPushButton#createAlbumButton:pressed {
    background-color: #6739B9;

    border-color: #FF9ED5;
}


QPushButton#createSingleButton {
    color: #D8FCFF;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 rgba(39, 215, 242, 35),
        stop: 1 rgba(139, 92, 246, 42)
    );

    border: 1px solid #288A9E;
}


QPushButton#createSingleButton:hover {
    color: #061519;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 #27D7F2,
        stop: 1 #8EDCFF
    );

    border-color: #B9FAFF;
}


QPushButton#createSingleButton:pressed {
    background-color: #1BAAC1;
}

QPushButton#accountButton {
    color: #E2DCFF;

    background-color: rgba(139, 92, 246, 26);

    border: 1px solid #624E91;
}


QPushButton#accountButton:hover {
    color: #FFFFFF;

    background-color: #59408D;

    border-color: #A889F4;
}


QPushButton#logoutButton {
    color: #FF9FC2;

    background-color: rgba(183, 43, 91, 28);

    border: 1px solid #783450;
}


QPushButton#logoutButton:hover {
    color: #FFFFFF;

    background-color: #B72B5B;

    border-color: #FF83AF;
}


QPushButton#logoutButton:pressed {
    background-color: #8C2146;
}


QFrame#mainFrame {
    background: transparent;

    border: none;
}


QFrame#headerFrame {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 1,
        stop: 0 rgba(35, 28, 74, 215),
        stop: 0.6 rgba(22, 22, 53, 205),
        stop: 1 rgba(40, 22, 66, 220)
    );

    border: 1px solid rgba(165, 108, 255, 85);

    border-radius: 16px;
}


QLabel#welcomeLabel {
    color: #FFFFFF;

    font-family: &quot;Bahnschrift&quot;;
    font-size: 18pt;
    font-weight: 700;
}


/* Subtitle */

QLabel#artistSubtitleLabel {
    color: #AAA3C2;

    font-size: 9.5pt;
}


/* Profile photo */

QLabel#profilePhotoLabel {
    color: #8E88A5;

    background: qradialgradient(
        cx: 0.5,
        cy: 0.35,
        radius: 0.9,
        stop: 0 #342D61,
        stop: 1 #121226
    );

    border: 2px solid #A66CFF;

    border-radius: 16px;
}


QFrame#statsFrame {
    background: transparent;

    border: none;
}

QFrame#albumStatFrame {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 1,
        stop: 0 rgba(112, 69, 206, 145),
        stop: 0.52 rgba(79, 49, 152, 125),
        stop: 1 rgba(31, 26, 70, 205)
    );

    border: 1px solid #8D68D7;

    border-radius: 15px;
}


QLabel#albumCountLabel {
    color: #FFFFFF;

    font-family: &quot;Bahnschrift&quot;;
    font-size: 24pt;
    font-weight: 700;
}


QLabel#albumCountTitleLabel {
    color: #D8CEEF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: 600;
}


QFrame#singleStatFrame {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 1,
        stop: 0 rgba(229, 69, 166, 150),
        stop: 0.5 rgba(132, 54, 142, 130),
        stop: 1 rgba(35, 24, 66, 210)
    );

    border: 1px solid #C6549D;

    border-radius: 15px;
}


QLabel#singleCountLabel {
    color: #FFFFFF;

    font-family: &quot;Bahnschrift&quot;;
    font-size: 24pt;
    font-weight: 700;
}


QLabel#singleCountTitleLabel {
    color: #F2CCE4;

    font-size: 10pt;
    font-weight: 600;
}


QLineEdit#searchLineEdit {
    min-height: 31px;

    color: #FFFFFF;

    background-color: rgba(13, 15, 34, 235);

    border: 1px solid #514875;

    border-radius: 12px;

    padding-left: 11px;
    padding-right: 11px;

    selection-background-color: #8B5CF6;
}


QLineEdit#searchLineEdit:hover {
    border-color: #8368BC;
}


QLineEdit#searchLineEdit:focus {
    background-color: #171831;

    border: 1px solid #27D7F2;
}


QPushButton#pushButton {
    min-width: 34px;
    max-width: 34px;

    min-height: 34px;
    max-height: 34px;

    padding: 0;

    color: #C8F9FF;

    background-color: rgba(39, 215, 242, 28);

    border: 1px solid #267D90;

    border-radius: 17px;
}


QPushButton#pushButton:hover {
    color: #071518;

    background-color: #27D7F2;

    border-color: #ABF8FF;
}



QComboBox#genreComboBox,
QComboBox#yearComboBox,
QComboBox#sortComboBox {
    min-height: 30px;

    color: #ECE9F7;

    background-color: #18172F;

    border: 1px solid #4D4769;

    border-radius: 8px;

    padding-left: 8px;

    selection-background-color: #8B5CF6;
}


QComboBox#genreComboBox:hover,
QComboBox#yearComboBox:hover,
QComboBox#sortComboBox:hover {
    background-color: #242044;

    border-color: #A778EF;
}


QComboBox#genreComboBox:focus,
QComboBox#yearComboBox:focus,
QComboBox#sortComboBox:focus {
    border-color: #27D7F2;
}


QComboBox::drop-down {
    width: 24px;

    border: none;
}


QComboBox QAbstractItemView {
    color: #F7F5FF;

    background-color: #14142B;

    border: 1px solid #654C90;

    border-radius: 7px;

    padding: 4px;

    outline: none;

    selection-background-color: #7044C9;
    selection-color: #FFFFFF;
}


QLabel#songsTitleLabel,
QLabel#releasesTitleLabel {
    color: #FFFFFF;

    font-family: &quot;Bahnschrift&quot;;

    font-size: 11pt;

    font-weight: 700;
}


QLabel#songsTitleLabel {
    color: #DDFBFF;
}


QLabel#releasesTitleLabel {
    color: #F1D8FF;
}


QTableWidget#songsTableWidget {
    color: #EBE8F5;

    background-color: rgba(11, 12, 29, 224);

    alternate-background-color: rgba(27, 24, 53, 195);

    border: 1px solid #392E57;

    border-radius: 13px;

    gridline-color: transparent;

    padding: 4px;

    outline: none;

    selection-background-color: transparent;
}


/* Song cells */

QTableWidget#songsTableWidget::item {
    padding: 7px;

    border: none;
}


/* Hover */

QTableWidget#songsTableWidget::item:hover {
    background-color: rgba(102, 71, 172, 75);

    border-radius: 7px;
}


/* Selected */

QTableWidget#songsTableWidget::item:selected {
    color: #FFFFFF;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 rgba(105, 65, 198, 190),
        stop: 0.48 rgba(139, 92, 246, 150),
        stop: 1 rgba(235, 72, 169, 110)
    );
}



QHeaderView {
    background: transparent;
}


QHeaderView::section {
    color: #AAA5BF;

    background-color: #111126;

    border: none;
    border-bottom: 1px solid #403655;

    padding: 7px;

    font-family: &quot;Segoe UI&quot;;

    font-size: 9pt;

    font-weight: 600;
}


QTableCornerButton::section {
    background-color: #111126;

    border: none;
}

QListWidget#albumsListWidget {
    color: #F3EFFB;

    background-color: rgba(11, 12, 29, 175);

    border: 1px solid #3A2F57;

    border-radius: 13px;

    padding: 5px;

    outline: none;
}


/* Album card */

QListWidget#albumsListWidget::item {
    color: #EEEAF8;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 rgba(45, 37, 83, 215),
        stop: 1 rgba(25, 22, 50, 225)
    );

    border: 1px solid rgba(131, 95, 195, 110);

    border-radius: 11px;

    padding: 6px;

    margin: 3px;
}


QListWidget#albumsListWidget::item:hover {
    color: #FFFFFF;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 1,
        stop: 0 rgba(105, 65, 198, 205),
        stop: 1 rgba(175, 55, 145, 180)
    );

    border-color: #B98DFF;
}


QListWidget#albumsListWidget::item:selected {
    color: #FFFFFF;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 1,
        stop: 0 #6941C6,
        stop: 0.55 #8B5CF6,
        stop: 1 #D946A5
    );

    border: 1px solid #27D7F2;
}


QPushButton {
    color: #F7F5FF;

    background-color: #1A1B37;

    border: 1px solid #4A4366;

    border-radius: 8px;

    min-height: 29px;

    padding: 2px 11px;

    font-weight: 600;
}


QPushButton:hover {
    background-color: #29244D;

    border-color: #9870EB;
}


QPushButton:pressed {
    background-color: #372C65;

    border-color: #F15BB5;
}



QScrollBar:vertical {
    width: 10px;

    background: transparent;

    margin: 4px 2px;
}


QScrollBar::handle:vertical {
    min-height: 28px;

    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #8A61D0,
        stop: 1 #4C3A75
    );

    border-radius: 5px;
}


QScrollBar::handle:vertical:hover {
    background-color: #A56CFF;
}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}


QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* Horizontal */

QScrollBar:horizontal {
    height: 9px;

    background: transparent;

    margin: 2px;
}


QScrollBar::handle:horizontal {
    min-width: 30px;

    background-color: #514177;

    border-radius: 4px;
}


QScrollBar::handle:horizontal:hover {
    background-color: #8B5CF6;
}


QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}



QToolTip {
    color: #FFFFFF;

    background-color: #191831;

    border: 1px solid #A271F0;

    border-radius: 6px;

    padding: 5px;
}</string>
